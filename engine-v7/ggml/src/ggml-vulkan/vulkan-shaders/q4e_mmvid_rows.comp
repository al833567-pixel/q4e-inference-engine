#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

// q4e: MUL_MAT_ID mat-vec for a small K, the down projection of MoE expert blocks (K = 320): one output row per
// thread, the activation of the token in shared memory. The generic mat-vec splits K over a whole workgroup, which
// leaves most threads idle at this K and reduces every row. Rows of an expert id < 0 (a block computed by another
// device) are written as zeros. Same push constants and bindings as mul_mat_vec.comp with MUL_MAT_ID.

#include "mul_mat_vec_base.glsl"
#include "dequant_funcs.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#define MAX_K 1024
shared FLOAT_TYPE sh_b[MAX_K];

void main() {
    const uint first_row = BLOCK_SIZE * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);
    const uint row       = first_row + gl_LocalInvocationID.x;

    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    // the id is the same for the whole workgroup
    if (int(expert_id) < 0) {
        if (row < p.stride_d) {
            data_d[d_offset + row] = D_TYPE(0);
        }
        return;
    }

    for (uint i = gl_LocalInvocationID.x; i < p.ncols; i += BLOCK_SIZE) {
        sh_b[i] = FLOAT_TYPE(data_b[b_offset + i]);
    }
    barrier();

    if (row >= p.stride_d) {
        return;
    }

    const uint nb  = p.ncols / QUANT_K;
    const uint ib0 = row * nb;
    FLOAT_TYPE sum = FLOAT_TYPE(0);
    for (uint b = 0; b < nb; ++b) {
        const uint ib = ib0 + b;
        FLOAT_TYPE s = FLOAT_TYPE(0);
        [[unroll]] for (uint q = 0; q < QUANT_K; q += 4) {
            const vec4 v  = dequantize4(ib, q, a_offset);
            const uint k  = b*QUANT_K + q;
            s += dot(v, vec4(sh_b[k], sh_b[k + 1], sh_b[k + 2], sh_b[k + 3]));
        }
        sum += s * FLOAT_TYPE(get_dm(ib, a_offset).x);
    }
    data_d[d_offset + row] = D_TYPE(sum);
}
